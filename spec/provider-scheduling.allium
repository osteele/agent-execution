-- allium: 3
-- provider-scheduling.allium
--
-- Scope: shared provider observations, probabilistic availability and quota
-- inference, cross-host scheduling, execution fallback, repair, synchronization,
-- retention, and operator governance for one user's subscription-backed agents.
-- Includes: synchronous and asynchronous execution, offline operation, evidence
-- provenance, quota reset prediction, capability beliefs, host pressure, and audit.
-- Excludes: multi-user tenancy, credential storage or rotation, automatic harness
-- installation on disabled hosts, central retention of full raw diagnostics,
-- exposure of intermediate scheduler hypotheses to agent sessions, and globally
-- exactly-once execution during network partitions.
-- Dependencies: harness execution and durable raw execution evidence are governed
-- by agent-execution.allium; providers, harnesses, hosts, and network paths are
-- external systems observed by this specification.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity Principal {
    principal_id: String
    active: Boolean
    authority: ClientAuthority | ReporterAuthority | ExecutorAuthority | MaintainerAuthority | OperatorAuthority
}

variant ClientAuthority : Principal {}
variant ReporterAuthority : Principal {}
variant ExecutorAuthority : Principal {}
variant MaintainerAuthority : Principal {}
variant OperatorAuthority : Principal {}

external entity InferencePayload {
    digest: String
}

external entity InferenceResult {
    digest: String
}

external entity RawExecutionEvidence {
    evidence_id: String
    restricted: Boolean
}

external entity ProviderStatusSource {
    source_id: String
    schema_version: String
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value SoftwareIdentity {
    name: String
    release_version: String?
    source_digest: String?
    git_commit: String?
    jj_change_id: String?
    protocol_version: String?
}

value EvidenceTime {
    occurred_at: Timestamp?
    observed_at: Timestamp
    received_at: Timestamp
    uncertainty: Duration
    source_sequence: Integer?
}

value NetworkContext {
    host: HostName
    exit_node: String?
    routing_profile: String?
    vpn_state: String?
    fingerprint: String
}

value EvidenceProvenance {
    reporter_class: ReporterClass
    reporter_id: String
    evidence_form: EvidenceForm
    source_reliability: Decimal
    producer: SoftwareIdentity
    harness: SoftwareIdentity?
    execution_context: String?
}

value QuotaSubject {
    service: SubscriptionService
    pool_kind: QuotaPoolKind
    model_family: ModelFamily?
    provider_pool_id: String?
}

value QuotaMeasurement {
    native_value: String?
    normalized_remaining_fraction: Decimal?
    provider_reported_reset_at: Timestamp?
    predicted_reset_at: Timestamp?
    reset_uncertainty: Duration?
}

value ResourceProbability {
    resource: ResourceKind
    probability: Decimal
}

value DerivationVersion {
    inference_model: String
    scheduler_policy: String
    capability_priors: String
    normalization_schema: String
}

value HardConstraints {
    provider: ProviderId?
    service: SubscriptionService?
    model: String?
    harness: HarnessName?
    host: HostName?
    required_capabilities: Set<String>
    privacy_requirements: Set<String>
    max_marginal_cost_usd: Decimal?
}

value RoutePreferences {
    preferred_provider: ProviderId?
    preferred_harness: HarnessName?
    preferred_host: HostName?
}

value TerminalExplanation {
    blocking_disposition: Disposition?
    unmet_constraint: String?
    next_recovery_at: Timestamp?
    recovery_action: String?
    evidence_ids: Set<String>
}

value SuccessfulExecution {
    provider: ProviderId
    service: SubscriptionService
    model: String
    harness: HarnessName
    host: HostName
    billing_class: BillingClass
    attempt_id: String
    result: InferenceResult
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum ProviderId {
    abliteration | aiand | `alibaba-coding-plan` | `alibaba-token-plan` |
    anthropic | baseten | cerebras | `charm-hyper` | `cline-pass` |
    `cloudflare-ai-gateway` | commandcode | coreweave | cursor | deepinfra |
    deepseek | devin | exa | firepass | fireworks | `github-copilot` |
    `gitlab-duo` | `gitlab-duo-agent` | `gmi-cloud` | `google-antigravity` |
    `google-gemini-cli` | huggingface | kagi | kilo | `kimi-code` |
    litellm | `llama.cpp` | `lm-studio` | meta | `minimax-code` |
    `minimax-code-cn` | moonshot | `muse-code` | nanogpt | novita | nvidia |
    ollama | `ollama-cloud` | `openai-codex` | `openai-codex-device` |
    `opencode-go` | `opencode-zen` | openrouter | parallel | perplexity |
    qianfan | `qwen-portal` | sakana | siliconflow | `siliconflow-cn` |
    stencil | synthetic | tavily | together | typesafe | umans | venice |
    `vercel-ai-gateway` | vllm | `wafer-serverless` | xai | `xai-oauth` |
    xiaomi | `xiaomi-token-plan-ams` | `xiaomi-token-plan-cn` |
    `xiaomi-token-plan-sgp` | `yolo-auto` | zai | `zai-coding-plan` |
    `zhipu-coding-plan` | zenmux
}

enum SubscriptionService {
    anthropic | google_antigravity | kimi_code | openai_codex | zhipu_coding_plan
}

enum HostName { workstation | studio | cool30 | cool100 }
enum HarnessName { claude | codex | opencode | kimi | gemini | agy | omp }
enum ModelFamily { gemini | other | unknown }
enum QuotaPoolKind { session | week | month | unknown }
enum ReporterClass { human | agent | scheduler | harness | provider | host_monitor | deployment_tool }
enum EvidenceForm { direct_output | structured_status | quoted_output | paraphrase | inference | manual_statement }
enum ObservationKind {
    execution_outcome | quota_status | authentication_status | subscription_status |
    capability_result | host_health | network_health | deployment_status |
    collector_parse_failure | user_report
}
enum Cause {
    quota_exhausted | subscription_lapsed | credential_missing_or_invalid |
    capability_absent | provider_outage | network_connectivity | network_routing |
    harness_defect | deployment_outdated | host_contention | directory_unclean |
    request_invalid | policy_denied | cancelled | unknown
}
enum ResourceKind { cpu | memory | swap | disk | gpu | process_capacity | unknown }
enum BillingClass { subscription_included | free | metered_paid | unknown }
enum Disposition {
    eligible | avoid | defer_until | repair_deployment | repair_required |
    disabled | permanently_blocked
}
enum RequestMode { synchronous | asynchronous }
enum RequestState { queued | running | succeeded | failed | cancelled }
enum AttemptState { admitted | running | succeeded | failed | cancelled | redundant }
enum LeaseKind { admission | execution | repair }
enum IncidentState { open | resolved }
enum PolicyProfile { interactive | batch | reliability_critical }
enum CandidateState { draft | replayed | approved | active | retired }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Host {
    name: HostName
}

entity ProviderAlias {
    alias: String
    service: SubscriptionService
}

entity QuotaPool {
    subject: QuotaSubject
}

entity ExecutionOption {
    option_id: String
    host: Host
    harness: HarnessName
    provider: ProviderId
    service: SubscriptionService
    model_family: ModelFamily?
    installed: Boolean
    explicitly_enabled: Boolean
    billing_class: BillingClass
    billing_class_established_at: Timestamp?
}

entity InitialOptionState {
    option: ExecutionOption
    disposition: Disposition
    basis: String
}

entity Observation {
    observation_id: String
    kind: ObservationKind
    provenance: EvidenceProvenance
    time: EvidenceTime
    network_context: NetworkContext?
    host: Host?
    option: ExecutionOption?
    quota_subject: QuotaSubject?
    capability: String?
    failure_mode: String?
    reported_cause: Cause?
    resource_probabilities: Set<ResourceProbability>
    quota: QuotaMeasurement?
    safe_excerpt: String?
    diagnostic_digest: String?
    raw_evidence: RawExecutionEvidence?
    positive: Boolean
}

entity Projection {
    projection_id: String
    option: ExecutionOption
    active_probability: Decimal
    quota_available_probability: Decimal
    cause_probabilities: String
    capability_probabilities: String
    disposition: Disposition
    defer_until: Timestamp?
    computed_at: Timestamp
    evidence_ids: Set<String>
    version: DerivationVersion
}

entity ModelCandidate {
    version: DerivationVersion
    state: CandidateState
    replay_report_digest: String?
    disposition_change_report_digest: String?
    approved_by: Principal?
}

entity ExecutionRequest {
    request_id: String
    client_id: String
    idempotency_key: String
    mode: RequestMode
    state: RequestState
    profile: PolicyProfile
    payload: InferencePayload
    payload_digest: String
    hard_constraints: HardConstraints
    preferences: RoutePreferences
    submitted_at: Timestamp
    deadline_at: Timestamp?
    attempt_cost_budget: Decimal?
    content_expires_at: Timestamp
    content_available: Boolean
    local_during_partition: Boolean
    success: SuccessfulExecution?
    failure: TerminalExplanation?

    attempts: ExecutionAttempt with request = this
}

entity ExecutionAttempt {
    attempt_id: String
    request: ExecutionRequest
    option: ExecutionOption
    state: AttemptState
    started_at: Timestamp
    completed_at: Timestamp?
    billing_class: BillingClass
    estimated_quota_consumption: String?
    actual_quota_consumption: String?
    result: InferenceResult?
    result_digest: String?
    result_delivered: Boolean
}

entity ExecutionLease {
    lease_id: String
    kind: LeaseKind
    holder: Principal
    request: ExecutionRequest?
    option: ExecutionOption?
    quota_subject: QuotaSubject?
    version_mismatch: String?
    expires_at: Timestamp
}

entity MaintenanceIncident {
    incident_id: String
    option: ExecutionOption
    disposition: Disposition
    state: IncidentState
    opened_at: Timestamp
    resolved_at: Timestamp?
    evidence_ids: Set<String>
}

entity StatusSourceState {
    source: ProviderStatusSource
    last_success_at: Timestamp?
    last_attempt_at: Timestamp?
    retry_after: Timestamp?
    stale: Boolean
    schema_recognized: Boolean
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    payload_delivery_window: Duration = 7.days
}

------------------------------------------------------------
-- Defaults
------------------------------------------------------------

default Host workstation_host = { name: workstation }
default Host studio_host = { name: studio }
default Host cool30_host = { name: cool30 }
default Host cool100_host = { name: cool100 }

-- No ExecutionOption is present for cool30 or cool100. Every harness on those
-- hosts is unschedulable until an explicit deployment creates and enables it.

